rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function role(r){return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == r;}
    function teacher(){return role('teacher');}

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    match /students/{id} {
      allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
      allow create: if teacher() && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if teacher() && resource.data.teacherUid == request.auth.uid;
    }
    match /memorization/{id} {
      allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid ||
        get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.guardianUid == request.auth.uid);
      allow create: if teacher() && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if teacher() && resource.data.teacherUid == request.auth.uid;
    }
    match /reviews/{id} {
      allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid ||
        get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.guardianUid == request.auth.uid);
      allow create: if teacher() && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if teacher() && resource.data.teacherUid == request.auth.uid;
    }
    match /attendance/{id} {
      allow read: if signedIn() && (resource.data.teacherUid == request.auth.uid ||
        get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.guardianUid == request.auth.uid);
      allow create, update: if teacher() && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if teacher() && resource.data.teacherUid == request.auth.uid;
    }
  }
}
